{
  "v": 2,
  "id": "shelly_dimmer2",
  "name": "Shelly Dimmer 2",
  "manufacturer": "Shelly",
  "protocol": "http",
  "port": 80,
  "behaviors": ["dimmer"],
  "commands": {
    "set_value": {
      "method": "GET",
      "path": "/light/0?brightness={value}",
      "min": 0,
      "max": 100,
      "step": 1
    },
    "toggle": {
      "method": "GET",
      "path": "/light/0?turn=toggle"
    }
  }
}
