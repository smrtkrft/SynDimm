{
  "v": 2,
  "id": "shelly_dali",
  "name": "Shelly DALI Dimmer Gen3",
  "manufacturer": "Shelly",
  "protocol": "http",
  "port": 80,
  "behaviors": ["dimmer"],
  "commands": {
    "set_value": {
      "method": "GET",
      "path": "/rpc/Light.Set?id=0&on=true&brightness={value}",
      "min": 0,
      "max": 100,
      "step": 1
    },
    "toggle": {
      "method": "GET",
      "path": "/rpc/Light.Toggle?id=0"
    }
  }
}
