{
  "v": 2,
  "id": "shelly_cover_g2",
  "name": "Shelly Plus 2PM Cover (Gen2+)",
  "manufacturer": "Shelly",
  "protocol": "http",
  "port": 80,
  "behaviors": ["shutter"],
  "commands": {
    "set_value": {
      "method": "GET",
      "path": "/rpc/Cover.GoToPosition?id=0&pos={value}",
      "min": 0,
      "max": 100,
      "step": 5
    },
    "stop": {
      "method": "GET",
      "path": "/rpc/Cover.Stop?id=0"
    }
  }
}
