{
  "id": "hue_bulb",
  "name": "Philips Hue Bulb",
  "manufacturer": "Philips",
  "mode": "dimmer",
  "protocol": "http",
  "host": "",
  "port": 80,
  "auth": {
    "type": "path_key",
    "key": ""
  },
  "commands": {
    "set_value": {
      "method": "PUT",
      "path": "/api/{auth_key}/lights/{device_id}/state",
      "body": "{\"bri\":{value}}",
      "min": 0,
      "max": 100,
      "map_min": 0,
      "map_max": 254,
      "step": 1
    },
    "toggle": {
      "method": "PUT",
      "path": "/api/{auth_key}/lights/{device_id}/state",
      "body": "{\"on\":{toggle}}"
    },
    "status": {
      "method": "GET",
      "path": "/api/{auth_key}/lights/{device_id}",
      "value_key": "bri",
      "state_key": "on",
      "map_min": 0,
      "map_max": 254
    }
  }
}
